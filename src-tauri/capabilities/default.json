{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "TokenAgency 主窗口的默认能力集",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:event:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "process:default",
    "notification:default",
    "clipboard-manager:default"
  ]
}
