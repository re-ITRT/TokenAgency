{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenAgency",
  "version": "0.1.0",
  "identifier": "dev.tokenagency.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TokenAgency",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 640,
        "resizable": true,
        "visible": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "TokenAgency",
    "shortDescription": "一个人的 LLM 中转站",
    "longDescription": "本地网关 + 语义路由 + 内嵌内核出网 + Clash Verge 式托盘",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/mihomo/mihomo.exe",
      "resources/mihomo/Country.mmdb"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
