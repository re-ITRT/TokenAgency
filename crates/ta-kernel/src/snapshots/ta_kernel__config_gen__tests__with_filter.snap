---
source: crates/ta-kernel/src/config_gen.rs
expression: yaml
---
# GENERATED BY TokenAgency — DO NOT EDIT
mode: rule
log-level: warning
mixed-port: 0
allow-lan: false
bind-address: 127.0.0.1
ipv6: false
find-process-mode: off
external-controller: 127.0.0.1:39090
secret: "test-secret"
profile: {store-selected: true, store-fake-ip: false}
tun: {enable: false}

dns:
  enable: true
  enhanced-mode: redir-host
  nameserver: ["https://223.5.5.5/dns-query", "https://doh.pub/dns-query"]
  proxy-server-nameserver: ["https://223.5.5.5/dns-query", "https://doh.pub/dns-query"]
  default-nameserver: ["223.5.5.5", "119.29.29.29"]

proxy-providers:
  sub-jp:
    type: http
    url: "https://example.com/api/v1/client/subscribe?token=REPLACE_ME"
    interval: 21600
    path: ./providers/sub-jp.yaml
    header:
      User-Agent: ["clash-verge/v2.0.0"]
    health-check: {enable: true, url: "https://www.gstatic.com/generate_204", interval: 60}

proxy-groups:
  - {name: "LANE-lane-jp-only", type: url-test, use: ["sub-jp"], url: "https://www.gstatic.com/generate_204", interval: 60, tolerance: 100, filter: "(?i)(日本|JP)", exclude-filter: "(?i)(官网|剩余流量)"}
  - {name: "LANE-lane-fallback", type: fallback, use: ["sub-jp"], url: "https://www.gstatic.com/generate_204", interval: 60, tolerance: 100}

listeners:
  - {name: "lane-lane-jp-only", type: mixed, listen: 127.0.0.1, port: 39100, proxy: "LANE-lane-jp-only", udp: false}
  - {name: "lane-lane-fallback", type: mixed, listen: 127.0.0.1, port: 39101, proxy: "LANE-lane-fallback", udp: false}

rules:
  - MATCH,DIRECT
