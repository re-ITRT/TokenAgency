#!/bin/sh
# TokenAgency commit-msg —— 轻量约定式提交检查。
# 允许：feat / fix / chore / docs / refactor / test / perf / build / ci / style / revert

msg_file="$1"
subject=$(head -n1 "$msg_file")

# 合并提交 / revert / fixup 放行
case "$subject" in
    Merge* | Revert* | fixup!* | squash!* | amend!*) exit 0 ;;
esac

if printf '%s' "$subject" | grep -qE '^(feat|fix|chore|docs|refactor|test|perf|build|ci|style|revert)(\([^)]+\))?!?: .{3,}$'; then
    exit 0
fi

printf '\033[31m\n✘ 提交信息不符合约定式提交格式\033[0m\n\n'
printf '  当前: %s\n\n' "$subject"
printf '  要求: <type>(<scope>): <描述>   描述至少 3 个字符\n'
printf '  type: feat|fix|chore|docs|refactor|test|perf|build|ci|style|revert\n\n'
printf '  例: feat(gateway): 实现全透传的头部定点修改\n'
printf '      fix(kernel): listeners 变更后强制重启内核\n\n'
exit 1
