#!/bin/sh
# TokenAgency pre-commit —— **直接提交**（git commit）的检查入口。
#
# 真正的检查逻辑在 **scripts/gate.ps1**（唯一真相源）。
#
# 为什么钩子只做转发：员工现在走 `scripts/pr.ps1` 提 PR，它用「临时 index +
# git commit-tree」组装分支提交 —— 而 `git commit-tree` **不触发任何钩子**。
# 如果钩子自带一套检查、pr.ps1 再自带一套，两套门禁迟早漂移，
# 那正是 docs/13 L21 记的那类问题（含糊/重复的地方会各自长出一套，且都不报错）。
#
# 安装：pwsh -File scripts/install-hooks.ps1
# 绕过：git commit --no-verify（仅限紧急情况）

if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File scripts/gate.ps1
elif command -v powershell.exe >/dev/null 2>&1; then
    exec powershell.exe -NoProfile -File scripts/gate.ps1
else
    printf '\033[31m\n✘ 找不到 pwsh / powershell，无法运行门禁 scripts/gate.ps1\033[0m\n'
    printf '  装了 PowerShell 7 之后重试。**不要用 --no-verify 绕过**——\n'
    printf '  那等于门禁失效，而门禁只在大家都愿意用时才有意义。\n\n'
    exit 1
fi
